# Root-level .gitignore for the Nawres Portfolio monorepo
# ─────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────
dist/
build/

# ── Environment / Secrets ─────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS artefacts ──────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# ── Test / Coverage ───────────────────────────────────────
coverage/

# ── Cache ─────────────────────────────────────────────────
.cache/
.parcel-cache/

# ── Misc ──────────────────────────────────────────────────
*.local
*.tsbuildinfo
