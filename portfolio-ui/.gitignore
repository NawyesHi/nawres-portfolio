# ──────────────────────────────────────────────────────────
# .gitignore – Vite + React portfolio
# ──────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment / Secrets ─────────────────────────────────
# Keep .env.example (safe template), ignore all real env files
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS artefacts ──────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Test / Coverage ───────────────────────────────────────
coverage/
.nyc_output/

# ── Cache ─────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ── Misc ──────────────────────────────────────────────────
*.local
*.tgz
*.tsbuildinfo
